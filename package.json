{
  "name": "vs-code-mobile",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:backend\" \"npm:frontend\"",
    "frontend": "vite --host 127.0.0.1",
    "backend": "node backend/server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android && npm run android:native",
    "android:open": "cap open android",
    "android:native": "node scripts/install-native-terminal.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  }
}
